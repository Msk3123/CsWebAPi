<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs\internal_logs\internallog.txt">
    <targets>
        <target name="logfile" xsi:type="File"
                fileName="logs\${shortdate}_logfile.txt"
                layout="${longdate} ${level:uppercase=true} ${message}"
                autoFlush="true"
                keepFileOpen="false"
                createDirs="true"/>
        <target name="console" xsi:type="Console"
                layout="${longdate} ${level:uppercase=true} ${message}" />
    </targets>
    <rules>
        <logger name="LoggerService.Logger.LoggerManager" minlevel="Debug" writeTo="logfile,console" />
        <logger name="CompanyEmployees.*" minlevel="Info" writeTo="logfile,console" />
        <logger name="Microsoft.*" maxlevel="Info" final="true" />
        <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
        <logger name="*" minlevel="Info" writeTo="logfile,console" />
    </rules>
</nlog>
